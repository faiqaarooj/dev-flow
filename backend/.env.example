# Copy this file to .env and provide your key locally.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

DATABASE_PATH=./devflow.db
GITHUB_API_BASE_URL=https://api.github.com
BANDIT_TIMEOUT_SECONDS=60
MAX_REPO_FILES=200
MAX_REPO_BYTES=5000000
MAX_FILE_BYTES=250000

# DNotifier / Notification Credentials
APP_ID=your_dnotifier_app_id_here
APP_SECRET=your_dnotifier_app_secret_here
DNOTIFIER_API_URL=https://api.dnotifier.com
